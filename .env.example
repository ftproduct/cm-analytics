# Copy to .env for local use: cp .env.example .env
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Databricks (pick one auth method) ---
# Service-principal OAuth (recommended)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# or a personal access token
DATABRICKS_TOKEN=
# Optional overrides (defaults are in api/_databricks.js)
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HTTP_PATH=

# --- Access control ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_EMAIL_DOMAIN=
ADMIN_EMAILS=

# --- Snapshot cache (optional) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Scheduled sync (optional) ---
CRON_SECRET=

# --- App options (optional) ---
MA_DEMO_MODE=
MA_DEV_ALLOW_ANONYMOUS=
MA_SCHEMA_JSON=
MA_SNAPSHOT_FILE=
MA_SNAPSHOT_CHUNK_CHARS=
MA_SYNC_DAYS=
MA_SYNC_MAX_ROWS=
