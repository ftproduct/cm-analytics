      "createdAt": "created_at",
      "pickupAt": null,
      "fulfilledAt": "vehicle_placed_ft_timestamp",
      "originCity": "origin",
      "originState": null,
      "destinationCity": "destination",
      "destinationState": null,
      "shipper": "shipper_name",
      "lsp": "lsp",
      "psa": "psa",
      "vehicleType": "truck_type",
      "materialType": "material",
      "region": null,
      "branch": null,
      "status": "status",
      "unfulfilmentReason": "cancellation_reason",
      "quantity": "required_no_of_trucks",
      "weightTons": "min_order_tonnage",
      "expectedPrice": "rate",
      "bookedPrice": "final_rate_quoted_csm_to_lsp",
      "laneType": "is_liquid_lane",
      "originSuperCluster": "origin_super_cluster_name",
      "destinationSuperCluster": "destination_super_cluster_name"
